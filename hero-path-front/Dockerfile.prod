# Прод-сборка фронта: собираем статику Vite и отдаём её nginx.
# Обычный Dockerfile в этой папке запускает dev-сервер Vite — он не годится
# для доступа снаружи: медленный, отдаёт исходники и держит вебсокет HMR.

FROM node:22-bookworm-slim AS build

WORKDIR /app

# Зависимости отдельным слоем: при правке кода npm ci не переустанавливается.
COPY package.json package-lock.json ./
RUN npm ci --no-audit --no-fund

COPY . .

# VITE_API_URL намеренно пустой: фронт и API живут на одном origin за nginx,
# запросы идут относительными путями (/api/v1/...). Так не нужен ни CORS,
# ни пересборка образа при смене IP или домена.
ENV VITE_API_URL=""
RUN npm run build

FROM nginx:1.27-alpine

COPY --from=build /app/dist /usr/share/nginx/html

EXPOSE 80
