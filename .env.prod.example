# Продакшен. Скопировать в `.env.prod`, заполнить и НЕ коммитить.
# Запуск: docker compose -f docker-compose.prod.yml --env-file .env.prod up -d
#
# Профиль hero_path.settings.prod намеренно падает на старте, если не заданы
# SECRET_KEY или ALLOWED_HOSTS: тихий старт с dev-ключом опаснее, чем отказ.

# --- Django (обязательные) ---
DJANGO_SETTINGS_MODULE=hero_path.settings.prod
# python -c "import secrets;print(secrets.token_urlsafe(64))"
SECRET_KEY=
# Домены, на которые отвечает бэкенд. Без порта и схемы.
ALLOWED_HOSTS=hero.example.ru
# Origin'ы фронта (со схемой). Пусто = браузерный фронт работать не будет.
CORS_ALLOWED_ORIGINS=https://hero.example.ru
CSRF_TRUSTED_ORIGINS=https://hero.example.ru
# 1 — когда TLS терминируется на nginx из этого же стека.
# 0 — если сертификата ещё нет или редирект делает внешний балансировщик.
SECURE_SSL_REDIRECT=1
SECURE_HSTS_SECONDS=2592000
LOG_LEVEL=INFO

# --- Хранилища внутри стека (в коде переопределяются compose-файлом) ---
MEDIA_ROOT=/var/lib/hero_path/media
STATIC_ROOT=/var/lib/hero_path/static

# --- Database ---
POSTGRES_DB=hero_path
POSTGRES_USER=hero_path
# Длинный случайный пароль. Наружу порт 5432 в проде не публикуется.
POSTGRES_PASSWORD=
POSTGRES_PORT=5432
POSTGRES_MAX_CONNECTIONS=200
# Живых соединений на процесс. За pgbouncer в transaction mode — 0.
DB_CONN_MAX_AGE=60

# --- Redis / Celery ---
REDIS_URL=redis://redis:6379/0
CELERY_CONCURRENCY=2

# --- Gunicorn / nginx ---
GUNICORN_WORKERS=3
GUNICORN_TIMEOUT=60
HTTP_PORT=80
HTTPS_PORT=443
IMAGE_TAG=latest

# --- Ограничение частоты (перебор пароля от LXP через наш логин) ---
THROTTLE_LOGIN=10/min
THROTTLE_LOGIN_BURST=60/hour
THROTTLE_WEBHOOK=120/min
THROTTLE_HEAVY=12/min

# --- Telegram (обязательно: единственный путь активации аккаунта) ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_ADMIN_CHAT_ID=
TELEGRAM_ALERTS_ENABLED=1
# Уведомления студентам: вызов на дуэль, респект, результат проверки квеста.
TELEGRAM_NOTIFICATIONS_ENABLED=1
TELEGRAM_ALERT_DEDUP_TTL=3600
ENVIRONMENT_NAME=production

# --- LXP (успеваемость и проверка паролей на логине) ---
LXP_GRAPHQL_ENDPOINT=https://api.newlxp.ru/graphql
LXP_BOT_EMAIL=
LXP_BOT_PASSWORD=
LXP_TOKEN_TTL_HOURS=23
LXP_VERIFY_URL=
LXP_API_TOKEN=
LXP_USE_BROWSER_TOKEN_BOT=0
LXP_WEB_BASE_URL=https://newlxp.ru
LXP_WEB_LOGIN_URL=https://newlxp.ru/sign-in
LXP_BROWSER_GRAPHQL_HOST=api.newlxp.ru
LXP_BROWSER_HEADLESS=1
LXP_BROWSER_TIMEOUT_MS=60000
LXP_SNAPSHOT_MAX_SUBORGS=20
LXP_SNAPSHOT_MAX_GROUPS=50
LXP_SNAPSHOT_DISCIPLINES_PER_QUERY=8

# --- HikCentral (проходы через турникеты) ---
# api | browser | snapshot | off
HIK_DATA_MODE=browser
HIK_USE_BROWSER_EXPORT=1
HIK_WEB_LOGIN_URL=https://www.hik-connectru.com/views/login/index.html#/login
HIK_WEB_EMAIL=
HIK_WEB_PASSWORD=
HIK_WEB_API_BASE=https://team.hikcentralconnectru.com
HIK_WEB_API_RECORDS_PATH=/hcc/hccacs/v1/event/certificateRecords/search
HIK_WEB_API_PAGE_SIZE=100
HIK_WEB_API_TIMEOUT=60
HIK_WEB_SESSION_TTL=21600
HIK_BROWSER_HEADLESS=1
HIK_BROWSER_TIMEOUT_MS=180000
HIK_BROWSER_DOWNLOAD_DIR=/tmp/hik_exports
HIK_FETCH_ENABLED=1
HIK_SSL_VERIFY=1
# Только для HIK_DATA_MODE=api
HIK_HOST=
HIK_PORT=443
HIK_APP_KEY=
HIK_APP_SECRET=

# --- YouGile (вебхук влияет на рейтинг: без секрета запросы отклоняются) ---
YOUGILE_API_URL=
YOUGILE_API_TOKEN=
YOUGILE_WEBHOOK_SECRET=

# --- Observability ---
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.05
