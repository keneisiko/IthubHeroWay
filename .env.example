# Скопируйте в `.env` для локальной разработки.
# В продакшене секреты только из vault / CI secrets / переменных хостинга — не коммить `.env`.

# --- Django ---
# dev | prod | test. В проде SECRET_KEY и ALLOWED_HOSTS обязательны, иначе приложение не стартует.
DJANGO_SETTINGS_MODULE=hero_path.settings.dev
SECRET_KEY=
DEBUG=1
ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0,web
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000
CSRF_TRUSTED_ORIGINS=
# Только для prod: 0, если TLS терминируется на балансировщике и он же делает редирект
SECURE_SSL_REDIRECT=1

# --- Database ---
POSTGRES_DB=hero_path
POSTGRES_USER=hero_path
POSTGRES_PASSWORD=hero_path
POSTGRES_HOST=db
POSTGRES_PORT=5432

# --- Redis / Celery ---
REDIS_URL=redis://redis:6379/0

# --- Telegram ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_ADMIN_CHAT_ID=
ENVIRONMENT_NAME=development
TELEGRAM_ALERTS_ENABLED=1
# Уведомления студентам: вызов на дуэль, респект, результат проверки квеста.
TELEGRAM_NOTIFICATIONS_ENABLED=1
TELEGRAM_ALERT_DEDUP_TTL=3600

# --- LXP ---
LXP_GRAPHQL_ENDPOINT=https://api.newlxp.ru/graphql
LXP_BOT_EMAIL=
LXP_BOT_PASSWORD=
LXP_TOKEN_TTL_HOURS=23
LXP_API_TOKEN=
LXP_VERIFY_URL=
LXP_USE_BROWSER_TOKEN_BOT=0
LXP_WEB_BASE_URL=https://newlxp.ru
LXP_WEB_LOGIN_URL=https://newlxp.ru/sign-in
LXP_BROWSER_GRAPHQL_HOST=api.newlxp.ru
LXP_BROWSER_HEADLESS=1
LXP_BROWSER_TIMEOUT_MS=60000
LXP_SNAPSHOT_MAX_SUBORGS=20
LXP_SNAPSHOT_MAX_GROUPS=50
LXP_SNAPSHOT_DISCIPLINES_PER_QUERY=8

# --- YouGile ---
YOUGILE_API_URL=
YOUGILE_API_TOKEN=

# --- Observability ---
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.05

# --- HikCentral OpenAPI / Browser export ---
HIK_HOST=https://hik.example.com
HIK_PORT=443
HIK_APP_KEY=
HIK_APP_SECRET=
# api | browser | snapshot | off
# browser = Playwright XLSX с hik-connectru (без OpenAPI)
HIK_DATA_MODE=browser
HIK_USE_BROWSER_EXPORT=1
HIK_WEB_LOGIN_URL=https://www.hik-connectru.com/views/login/index.html#/login
HIK_WEB_EMAIL=
HIK_WEB_PASSWORD=
# Прямая ссылка на страницу записей (если известна), иначе клики по HIK_WEB_NAV_STEPS
HIK_WEB_RECORDS_URL=
# Интерфейс портала доступен только на en/zh_CN/ar — русские названия пунктов меню
# не совпадут. Уточнить фактические названия: manage.py probe_hik_web --headed
# Пункты меню портала: раздел, раскрывающийся «Search», страница записей.
# Проверено на hik-connectru: интерфейс английский, «Search» — это подменю,
# а нужная страница называется Access Record Retrieval.
HIK_WEB_NAV_STEPS=Access Control|Search|Access Record Retrieval
# Портал медленно отрисовывается; 180000 мс — рабочее значение, меньше ставить рискованно
HIK_BROWSER_HEADLESS=1
HIK_BROWSER_TIMEOUT_MS=180000

# Внутреннее API портала — прямой HTTP вместо кликов по меню.
# Значения сняты командой `manage.py probe_hik_web`; менять, если портал обновится.
HIK_WEB_API_BASE=https://team.hikcentralconnectru.com
HIK_WEB_API_RECORDS_PATH=/hcc/hccacs/v1/event/certificateRecords/search
HIK_WEB_API_PAGE_SIZE=100
HIK_WEB_API_TIMEOUT=60
# Сколько держать cookies портала до повторного входа (секунды)
HIK_WEB_SESSION_TTL=21600
HIK_BROWSER_TIMEOUT_MS=120000
HIK_FETCH_ENABLED=1
HIK_FETCH_LOOKBACK_HOURS=2
HIK_REQUEST_TIMEOUT=30
HIK_MAX_RETRIES=3
HIK_SSL_VERIFY=1
# Путь см. доку вашей версии HCP (может быть eventService …)
HIK_ARTEMIS_EVENT_RECORDS_PATH=/artemis/api/event/v1/eventRecords/pages
HIK_ARTEMIS_TIME_FORMAT=%Y-%m-%dT%H:%M:%S.000
HIK_SIGNATURE_DASH_HEADERS=1
HIK_SIGNATURE_HEADERS=x-ca-key,x-ca-nonce,x-ca-timestamp
HIK_EVENT_QUERY_EXTRA_JSON=
HIK_ARTEMIS_PERSON_PATH=

# --- Опоздания и серии (переопределение RATING_KP, значения по модулю) ---
LATE_PENALTY_LIGHT=3
LATE_PENALTY_MODERATE=5
LATE_PENALTY_SEVERE=8
LATE_STRIKE_7D_BONUS=5
LATE_STRIKE_14D_BONUS=10
LATE_STRIKE_21D_BONUS=15
ATTENDANCE_FULL_WEEK_BONUS=15
ATTENDANCE_STRIKE_7D_BONUS=5
